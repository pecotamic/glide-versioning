{
  "name": "pecotamic/glide-versioning",
  "description": "Cache busting for statically cached Glide images in Statamic",
  "type": "statamic-addon",
  "license": "MIT",
  "keywords": [
    "statamic",
    "glide",
    "cache",
    "cache busting"
  ],
  "require": {
    "php": "^8.2",
    "statamic/cms": "^5.0|^6.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Pecotamic\\GlideVersioning\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pecotamic\\GlideVersioning\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "statamic": {
      "name": "Pecotamic Glide Versioning",
      "description": "New image URL whenever an asset changes, so Glide images can be cached forever"
    },
    "laravel": {
      "providers": [
        "Pecotamic\\GlideVersioning\\ServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Werner Freytag",
      "email": "wf@pecora.de"
    }
  ],
  "config": {
    "allow-plugins": {
      "pixelfear/composer-dist-plugin": true
    }
  }
}
